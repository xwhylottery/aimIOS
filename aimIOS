local HUD_ACTIONS = {
    "Jump", "Attack (Tool)", "Shoot (Click)", "Aim (RMB)",
    "Forward", "Back", "Left", "Right",
    "Shift Lock", "Reload", "Interact",
}

local customBtns, nextBtnId, EDIT_MODE = {}, 0, false

local function fireAction(action, isDown)
    if not action then return end
    local char = LP.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum then return end

    if action == "Jump" then
        if isDown then
            hum.Jump = true
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
        end
    elseif action == "Attack (Tool)" then
        if isDown then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then pcall(function() tool:Activate() end) end
        end
    elseif action == "Shoot (Click)" then
        if isDown then
            pcall(function()
                local vim = game:GetService("VirtualInputManager")
                vim:SendMouseButtonEvent(0,0,0,true,game,1)
                task.wait(0.03)
                vim:SendMouseButtonEvent(0,0,0,false,game,1)
            end)
        end
    elseif action == "Aim (RMB)" then
        UserInputService.MouseBehavior = isDown
            and Enum.MouseBehavior.LockCenter or Enum.MouseBehavior.Default
    elseif action == "Forward" or action == "Back"
        or action == "Left" or action == "Right" then
        if not isDown then hum:Move(Vector3.zero, false); return end
        local cam = Camera.CFrame
        local dir = Vector3.zero
        if action == "Forward" then dir = cam.LookVector end
        if action == "Back"    then dir = -cam.LookVector end
        if action == "Left"    then dir = -cam.RightVector end
        if action == "Right"   then dir = cam.RightVector end
        hum:Move(Vector3.new(dir.X, 0, dir.Z), false)
    elseif action == "Shift Lock" then
        UserInputService.MouseBehavior = isDown
            and Enum.MouseBehavior.LockCenter or Enum.MouseBehavior.Default
    elseif action == "Reload" then
        if isDown then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                pcall(function()
                    hum:UnequipTools(); task.wait(0.08); tool.Parent = char
                end)
            end
        end
    elseif action == "Interact" then
        if isDown then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("ProximityPrompt") then
                        local parent = obj.Parent
                        if parent and parent:IsA("BasePart") then
                            local dist = (parent.Position - hrp.Position).Magnitude
                            if dist <= obj.MaxActivationDistance then
                                pcall(function()
                                    obj:InputHoldBegin()
                                    task.wait(obj.HoldDuration)
                                    obj:InputHoldEnd()
                                end)
                                break
                            end
                        end
                    end
                end
            end
        end
    end
end

local function makeCustomButton(action, x, y, size)
    if type(action) ~= "string" or action == "" then action = "Jump" end
    size = tonumber(size) or 70
    x = tonumber(x) or 100
    y = tonumber(y) or 200

    nextBtnId = nextBtnId + 1
    local id = nextBtnId

    local btn = Instance.new("TextButton", HudGui)
    btn.Name = "HUD_" .. id
    btn.Size = UDim2.fromOffset(size, size)
    btn.Position = UDim2.fromOffset(x, y)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    btn.BackgroundTransparency = 0.35
    btn.Text = action
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.TextWrapped = true
    btn.BorderSizePixel = 0
    btn.Active = true
    btn.ZIndex = 100
    btn.Selectable = false
    btn.AutoButtonColor = false
    Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)

    local stroke = Instance.new("UIStroke", btn)
    stroke.Thickness = 2
    stroke.Color = Color3.fromRGB(80, 160, 240)
    stroke.Transparency = 0.4

    local data = {id=id, action=action, button=btn}
    customBtns[id] = data

    local function setPressed(on)
        if on then
            btn.BackgroundColor3 = Color3.fromRGB(60, 130, 200)
            btn.BackgroundTransparency = 0.15
        else
            btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
            btn.BackgroundTransparency = EDIT_MODE and 0.15 or 0.35
        end
    end

    local del = Instance.new("TextButton", btn)
    del.Size = UDim2.fromOffset(22, 22)
    del.Position = UDim2.new(1, -11, 0, -11)
    del.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
    del.Text = "×"
    del.TextColor3 = Color3.new(1,1,1)
    del.Font = Enum.Font.GothamBold
    del.TextSize = 14
    del.BorderSizePixel = 0
    del.Visible = false
    del.ZIndex = 120
    Instance.new("UICorner", del).CornerRadius = UDim.new(1, 0)
    del.MouseButton1Click:Connect(function()
        customBtns[id] = nil
        btn:Destroy()
    end)
    data.deleteBtn = del

    btn.InputBegan:Connect(function(i)
        local isTap = i.UserInputType == Enum.UserInputType.Touch
            or i.UserInputType == Enum.UserInputType.MouseButton1
        if not isTap then return end
        if EDIT_MODE then
            local dragStart = i.Position
            local startPos = btn.Position
            local moveConn, endConn
            moveConn = UserInputService.InputChanged:Connect(function(m)
                if m.UserInputType == Enum.UserInputType.Touch
                or m.UserInputType == Enum.UserInputType.MouseMovement then
                    local d = m.Position - dragStart
                    btn.Position = UDim2.fromOffset(
                        startPos.X.Offset + d.X,
                        startPos.Y.Offset + d.Y)
                end
            end)
            endConn = UserInputService.InputEnded:Connect(function(e)
                if e.UserInputType == Enum.UserInputType.Touch
                or e.UserInputType == Enum.UserInputType.MouseButton1 then
                    if moveConn and moveConn.Disconnect then moveConn:Disconnect() end
                    if endConn and endConn.Disconnect then endConn:Disconnect() end
                end
            end)
        else
            setPressed(true)
            fireAction(action, true)
        end
    end)
    btn.InputEnded:Connect(function(i)
        if EDIT_MODE then return end
        local isTap = i.UserInputType == Enum.UserInputType.Touch
            or i.UserInputType == Enum.UserInputType.MouseButton1
        if not isTap then return end
        setPressed(false)
        fireAction(action, false)
    end)
    return data
end

