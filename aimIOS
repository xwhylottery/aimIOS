-- FOV update
RunService.RenderStepped:Connect(function()
    if not _G.CFG.aimShowFov then fovCircle.Visible = false; return end
    fovCircle.Visible = true
    local vp = Camera.ViewportSize
    local camFov = math.rad(Camera.FieldOfView)
    local aimFovRad = math.rad(_G.CFG.aimFov)
    local halfHeight = vp.Y / 2
    local radiusPx = (math.tan(aimFovRad / 2) / math.tan(camFov / 2)) * halfHeight
    fovCircle.Size = UDim2.fromOffset(radiusPx * 2, radiusPx * 2)
end)

-- Aim
local aimParams = RaycastParams.new()
aimParams.FilterType = Enum.RaycastFilterType.Exclude
aimParams.IgnoreWater = true

local function getPart(plr)
    local char = plr.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil end
    local p = char:FindFirstChild(_G.CFG.aimPart)
        or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    return p, char
end

local function isVisible(part, char)
    if not _G.CFG.aimWall then return true end
    aimParams.FilterDescendantsInstances = {LP.Character, Camera}
    local origin = Camera.CFrame.Position
    local hit = workspace:Raycast(origin, part.Position - origin, aimParams)
    return hit and hit.Instance:IsDescendantOf(char) or false
end

local function inFov(pos)
    local origin = Camera.CFrame.Position
    local dir = pos - origin
    if dir.Magnitude == 0 then return false end
    local a = math.deg(math.acos(math.clamp(Camera.CFrame.LookVector:Dot(dir.Unit), -1, 1)))
    return a <= _G.CFG.aimFov
end

local function bestTarget()
    local best, score = nil, math.huge
    local origin = Camera.CFrame.Position
    for _, plr in Players:GetPlayers() do
        if plr == LP then continue end
        if _G.CFG.aimTeam and plr.Team == LP.Team then continue end
        local part, char = getPart(plr)
        if not part then continue end
        local d = (part.Position - origin).Magnitude
        if d > _G.CFG.aimMaxDist then continue end
        if not inFov(part.Position) then continue end
        if not isVisible(part, char) then continue end
        local dir = part.Position - origin
        local a = math.deg(math.acos(math.clamp(Camera.CFrame.LookVector:Dot(dir.Unit), -1, 1)))
        if a < score then score = a; best = part end
    end
    return best
end

local aimActive, aimStart = false, 0
local function keyDown()
    local k = _G.CFG.aimKey
    if k == "Always" then return true end
    if k == "MouseRight" then return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) end
    if k == "MouseLeft" then return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) end
    return false
end

RunService.RenderStepped:Connect(function()
    if not _G.CFG.aimEnabled then return end
    local down = keyDown()
    if down and not aimActive then aimActive = true; aimStart = tick()
    elseif not down then aimActive = false; return end
    if tick() - aimStart < _G.CFG.aimReaction then return end
    local t = bestTarget()
    if not t then return end
    local goal = CFrame.new(Camera.CFrame.Position, t.Position)
    if _G.CFG.aimMode == "Rage" then
        Camera.CFrame = goal
    else
        Camera.CFrame = Camera.CFrame:Lerp(goal, _G.CFG.aimSmooth)
    end
end)

