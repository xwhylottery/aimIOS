local hitboxCache = {}
local function applyHitbox(char, plr)
    if not char then return end
    local size = _G.CFG.hitboxSize
    local data = hitboxCache[plr] or {}
    hitboxCache[plr] = data
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            if not data[part] then data[part] = part.Size end
            part.Size = data[part] * size
            part.Transparency = _G.CFG.hitboxTransparency
            part.CanCollide = false
            part.Massless = true
        end
    end
end
local function resetHitbox(char, plr)
    local data = hitboxCache[plr]
    if not data then return end
    for part, size in pairs(data) do
        if part and part.Parent then part.Size = size end
    end
    hitboxCache[plr] = nil
end
task.spawn(function()
    while task.wait(0.3) do
        if not _G.CFG.hitboxEnabled then
            for plr, _ in pairs(hitboxCache) do
                resetHitbox(plr.Character, plr)
            end
        else
            for _, plr in Players:GetPlayers() do
                if plr == LP then continue end
                if _G.CFG.hitboxTeam and plr.Team == LP.Team then continue end
                if plr.Character then applyHitbox(plr.Character, plr) end
            end
        end
    end
end)
