RunService.RenderStepped:Connect(function()
    if not _G.CFG.espEnabled then
        for _, d in pairs(espCache) do d.holder.Visible = false end
        return
    end
    for _, plr in Players:GetPlayers() do
        if plr == LP then continue end
        if not espCache[plr] then makeBox(plr) end
        local d = espCache[plr]
        local char = plr.Character
        local head = char and char:FindFirstChild("Head")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not (char and head and hrp and hum) or hum.Health <= 0 then
            d.holder.Visible = false; continue
        end
        local origin = Camera.CFrame.Position
        local dist = (hrp.Position - origin).Magnitude
        if dist > _G.CFG.espMaxDist then d.holder.Visible = false; continue end
        local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if not onScreen then d.holder.Visible = false; continue end
        local top = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1, 0))
        local bot = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
        local h = math.abs(top.Y - bot.Y)
        local w = h * 0.55
        d.holder.Visible = true
        d.holder.Position = UDim2.fromOffset(pos.X - w/2, top.Y)
