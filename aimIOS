local skelCache = {}

local R15_BONES = {
    {"Head", "UpperTorso"},
    {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"},
    {"LeftUpperArm", "LeftLowerArm"},
    {"LeftLowerArm", "LeftHand"},
    {"UpperTorso", "RightUpperArm"},
    {"RightUpperArm", "RightLowerArm"},
    {"RightLowerArm", "RightHand"},
    {"LowerTorso", "LeftUpperLeg"},
    {"LeftUpperLeg", "LeftLowerLeg"},
    {"LeftLowerLeg", "LeftFoot"},
    {"LowerTorso", "RightUpperLeg"},
    {"RightUpperLeg", "RightLowerLeg"},
    {"RightLowerLeg", "RightFoot"},
}
local R6_BONES = {
    {"Head", "Torso"},
    {"Torso", "Left Arm"},
    {"Torso", "Right Arm"},
    {"Torso", "Left Leg"},
    {"Torso", "Right Leg"},
}

local function makeSkelHolder()
    local holder = Instance.new("Frame")
    holder.BackgroundTransparency = 1
    holder.BorderSizePixel = 0
    holder.Visible = false
    holder.ZIndex = 4
    holder.Active = false
    holder.ClipsDescendants = false
    holder.Parent = ScreenGui
    return holder
end

local function makeSkelLines(holder, count)
    local lines = {}
    for i = 1, count do
        local l = Instance.new("Frame", holder)
        l.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
        l.BorderSizePixel = 0
        l.AnchorPoint = Vector2.new(0.5, 0.5)
        l.ZIndex = 4
        lines[i] = l
    end
    return lines
end

local function updateSkeleton(holder, lines, char)
    local isR15 = char:FindFirstChild("UpperTorso") ~= nil
    local bones = isR15 and R15_BONES or R6_BONES

    for i, pair in ipairs(bones) do
        local a = char:FindFirstChild(pair[1])
        local b = char:FindFirstChild(pair[2])
        local line = lines[i]
        if a and b and line then
            local pa, onA = Camera:WorldToViewportPoint(a.Position)
            local pb, onB = Camera:WorldToViewportPoint(b.Position)
            if onA and onB then
                local dx = pb.X - pa.X
                local dy = pb.Y - pa.Y
                local len = math.sqrt(dx*dx + dy*dy)
                if len > 1 then
                    line.Visible = true
                    line.Size = UDim2.fromOffset(len, _G.CFG.skelThickness)
                    line.Position = UDim2.fromOffset((pa.X+pb.X)/2, (pa.Y+pb.Y)/2)
                    line.Rotation = math.deg(math.atan2(dy, dx))
                    line.BackgroundColor3 = _G.CFG.skelColor
                else
                    line.Visible = false
                end
            else
                line.Visible = false
            end
        elseif line then
            line.Visible = false
        end
    end
    for i = #bones + 1, #lines do
        lines[i].Visible = false
    end
end

RunService.RenderStepped:Connect(function()
    if not _G.CFG.skelEnabled then
        for _, d in pairs(skelCache) do d.holder.Visible = false end
        return
    end
    for _, plr in Players:GetPlayers() do
        if plr == LP then continue end
        if not skelCache[plr] then
            local holder = makeSkelHolder()
            local lines = makeSkelLines(holder, #R15_BONES)
            skelCache[plr] = {holder=holder, lines=lines}
        end
        local d = skelCache[plr]
        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not (char and hrp and hum) or hum.Health <= 0 then
            d.holder.Visible = false; continue
        end
        local dist = (hrp.Position - Camera.CFrame.Position).Magnitude
        if dist > _G.CFG.skelMaxDist then
            d.holder.Visible = false; continue
        end
        d.holder.Visible = true
        updateSkeleton(d.holder, d.lines, char)
    end
end)

